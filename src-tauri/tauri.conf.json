{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lynk Dev",
  "version": "0.1.0",
  "identifier": "io.github.moha528.lynkdev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lynk Dev",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "moha528",
    "category": "DeveloperTool",
    "shortDescription": "Suite d'outils de developpement desktop",
    "longDescription": "Lynk Dev — suite d'outils de developpement desktop : Git Manager, Dev Manager, DB Explorer. Local-first, multi-themes, cross-platform.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 moha528",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": ["English", "French"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/moha528/lynk-dev/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczMjk5MDZGQjJFMERBRDYKUldUVzJ1Q3liNUFwYzZwWUZjTitxcnhDUEphazBSZzFtenpwcWpNbHBNV202U1RLREIvOUs0NWEK"
    }
  }
}
